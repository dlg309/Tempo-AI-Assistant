# Required for authentication and persistent manual planning.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only; required for private feed reads and scheduled refresh jobs.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional: manual planning works without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional live integration smoke test (use a disposable project/account).
TEMPO_TEST_BASE_URL=http://localhost:3000
TEMPO_TEST_EMAIL=
TEMPO_TEST_PASSWORD=
